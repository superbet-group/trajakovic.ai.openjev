#!/usr/bin/env bash
# Stop the OpenJev server started by ./startOpenJev.
cd "$(dirname "$0")" || exit 1

if [ -f .openjev.pid ] && kill -0 "$(cat .openjev.pid)" 2>/dev/null; then
  kill "$(cat .openjev.pid)"
  echo "Stopped OpenJev (PID $(cat .openjev.pid))."
else
  pkill -f "python -m openjev" && echo "Stopped OpenJev." || echo "OpenJev is not running."
fi
rm -f .openjev.pid
