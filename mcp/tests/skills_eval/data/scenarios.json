{
 "schema_version": 1,
 "notes": "setup is a list of steps with an 'op' key: copy_fixtures{files: dest->fixture name under fixtures/}, write_text{path,text} (relative to cwd unless absolute), seed_batch_output{items_fixture,questions,output,n_done}, none. checks use the plan vocabulary; args_match/result_matches paths accept len(path); 'call' is first|last|any. mcp:false means no openjev server is configured.",
 "scenarios": [
  {
   "id": "L01",
   "slug": "csv_batch_dry_run_then_chain",
   "subset": "explicit",
   "skill": "openjev-data-records",
   "prompt": "/openjev-skills:openjev-data-records The file {cwd}/tickets.csv has 30 support tickets (columns id, state). For each one decide whether it needs a human today (yes or no) and write the labelled rows to {cwd}/out.jsonl. Go easy on the server: no more than 2 reads at a time. Check what will be imported before spending any reads.",
   "setup": [
    {
     "op": "copy_fixtures",
     "files": {
      "tickets.csv": "tickets_30.csv"
     }
    }
   ],
   "checks": [
    {
     "check": "first_call",
     "tool": "batch",
     "args": {
      "dry_run": {
       "op": "eq",
       "value": true
      }
     }
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "output_path",
     "pred": {
      "op": "abs_path",
      "value": "{cwd}/out.jsonl"
     },
     "call": "any"
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "concurrency",
     "pred": {
      "op": "le",
      "value": 2
     },
     "call": "any"
    },
    {
     "check": "result_matches",
     "tool": "batch",
     "path": "$.status.stopped_reason",
     "pred": {
      "op": "eq",
      "value": "complete"
     },
     "call": "last"
    },
    {
     "check": "jsonl_rows",
     "path": "{cwd}/out.jsonl",
     "n": 30,
     "unique": true
    },
    {
     "check": "no_permission_denials"
    }
   ],
   "tools": "Read,Glob,Write",
   "allow": [
    "mcp__openjev",
    "Read",
    "Glob",
    "Write"
   ],
   "max_turns": 12,
   "budget_usd": 0.5,
   "source": "T087; g04 T029/T032"
  },
  {
   "id": "L02",
   "slug": "resume_partial_output",
   "subset": "implicit",
   "skill": "openjev-data-records",
   "prompt": "A labelling run over {cwd}/items.csv (columns id, state) stopped part-way and its results so far are in {cwd}/out.jsonl. Finish the job without redoing rows that are already done and without starting a second output file. The question was: {\"type\": \"noul\", \"instructions\": \"Does this need a human to look at it today?\", \"criteria\": {\"true\": \"something is broken, blocked, leaking money or data, or has a deadline\", \"false\": \"routine, informational, or can wait\"}}",
   "setup": [
    {
     "op": "copy_fixtures",
     "files": {
      "items.csv": "tickets_20.csv"
     }
    },
    {
     "op": "seed_batch_output",
     "items_fixture": "tickets_20.csv",
     "questions": {
      "urgent": {
       "type": "noul",
       "instructions": "Does this need a human to look at it today?",
       "criteria": {
        "true": "something is broken, blocked, leaking money or data, or has a deadline",
        "false": "routine, informational, or can wait"
       }
      }
     },
     "output": "out.jsonl",
     "n_done": 8
    }
   ],
   "checks": [
    {
     "check": "args_match",
     "tool": "batch",
     "path": "output_path",
     "pred": {
      "op": "abs_path",
      "value": "{cwd}/out.jsonl"
     },
     "call": "any"
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "resume",
     "pred": {
      "op": "ne",
      "value": false
     },
     "call": "any"
    },
    {
     "check": "result_matches",
     "tool": "batch",
     "path": "$.status.skipped",
     "pred": {
      "op": "ge",
      "value": 8
     },
     "call": "first"
    },
    {
     "check": "result_matches",
     "tool": "batch",
     "path": "$.status.stopped_reason",
     "pred": {
      "op": "eq",
      "value": "complete"
     },
     "call": "last"
    },
    {
     "check": "jsonl_rows",
     "path": "{cwd}/out.jsonl",
     "n": 20,
     "unique": true
    },
    {
     "check": "no_permission_denials"
    }
   ],
   "tools": "Read,Glob,Write",
   "allow": [
    "mcp__openjev",
    "Read",
    "Glob",
    "Write"
   ],
   "max_turns": 8,
   "budget_usd": 0.5,
   "source": "g04 T033 batch_resume"
  },
  {
   "id": "L03",
   "slug": "nested_jsonl_state_template",
   "subset": "explicit",
   "skill": "openjev-data-prep",
   "prompt": "/openjev-skills:openjev-data-prep {cwd}/tickets.jsonl holds 12 helpdesk tickets as JSON lines, each with a subject and a body plus some account details. Label every ticket as needing a human today or not, using both the subject and the body as context. Write the results to {cwd}/out.jsonl and check the import before running for real.",
   "setup": [
    {
     "op": "copy_fixtures",
     "files": {
      "tickets.jsonl": "tickets_nested.jsonl"
     }
    }
   ],
   "checks": [
    {
     "check": "first_call",
     "tool": "batch",
     "args": {
      "dry_run": {
       "op": "eq",
       "value": true
      }
     }
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "items_file.state_template",
     "pred": {
      "op": "regex",
      "value": "\\{subject\\}"
     },
     "call": "any"
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "items_file.state_template",
     "pred": {
      "op": "regex",
      "value": "\\{body\\}"
     },
     "call": "any"
    },
    {
     "check": "args_match",
     "tool": "batch",
     "path": "items_file.id_field",
     "pred": {
      "op": "eq",
      "value": "ticket_id"
     },
     "call": "any"
    },
    {
     "check": "import_no_warnings",
     "codes": [
      "W601",
      "W602"
     ]
    },
    {
     "check": "jsonl_rows",
     "path": "{cwd}/out.jsonl",
     "n": 12,
     "unique": true
    }
   ],
   "tools": "Read,Glob,Write",
   "allow": [
    "mcp__openjev",
    "Read",
    "Glob",
    "Write"
   ],
   "max_turns": 8,
   "budget_usd": 0.5,
   "source": "uc-data-prep; g04 T031"
  },
