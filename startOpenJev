#!/usr/bin/env bash
# Start the OpenJev server (MLX backend) in the background on 127.0.0.1:8080.
cd "$(dirname "$0")" || exit 1

if [ -f .openjev.pid ] && kill -0 "$(cat .openjev.pid)" 2>/dev/null; then
  echo "Already running (PID $(cat .openjev.pid)). Use mise run logsOpenJev to follow the log."
  exit 0
fi

OPENJEV_BACKEND=${OPENJEV_BACKEND:-mlx} nohup .venv/bin/python -m openjev >> .openjev.log 2>&1 &
echo $! > .openjev.pid
echo "Started OpenJev (PID $!). Log: mise run logsOpenJev   Stop: mise run stopOpenJev"
echo "First start loads the model; ready when 'curl http://127.0.0.1:8080/v1/models' answers."
